# Copy to .env (local) or set in Netlify/Vercel "Environment variables".
# Your live domain once known (no trailing slash). Used for canonical + Open Graph URLs.
VITE_SITE_URL=

# Server-side email delivery via Resend (do not prefix these with VITE_).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
